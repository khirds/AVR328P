    // --- VALIDATION before submitting ---
    function validateForm() {
        const name = document.getElementById("customer-name").value.trim();
        const phone = document.getElementById("customer-phone").value.trim();
        const email = document.getElementById("customer-email").value.trim();
        const deliverySelected = (document.querySelector('input[name="delivery_days"]:checked') || {}).value;
        const qtyVal = parseInt(qtyInput?.value || "0", 10);

        if (!name) {
            alert("Please enter your full name.");
            return false;
        }
        if (!/^[0-9]{10,15}$/.test(phone)) {
            alert("Please enter a valid phone number (10–15 digits).");
            return false;
        }
        if (!email || !/^[^@]+@[^@]+\.[^@]+$/.test(email)) {
            alert("Please enter a valid email address.");
            return false;
        }
        // ✅ Enforce min quantity when 6_11 is selected
        if (deliverySelected === "6_11" && qtyVal < 5) {
            alert("For 6–11 day delivery, the minimum quantity is 5 pieces.");
            qtyInput.value = 5;
            return false;
        }
        return true;
    }

    // --- Enforce quantity rule based on delivery selection ---
    function enforceQuantityRule() {
        const selected = (document.querySelector('input[name="delivery_days"]:checked') || {}).value;
        if (!qtyInput) return;

        if (selected === "6_11") {
            qtyInput.min = 5;
            if (!qtyInput.value || parseInt(qtyInput.value, 10) < 5) {
                qtyInput.value = 5;
            }
        } else {
            qtyInput.min = 1;
            if (!qtyInput.value || parseInt(qtyInput.value, 10) < 1) {
                qtyInput.value = 1;
            }
        }
    }

    // Blur validation for quantity when 6_11 selected
    qtyInput?.addEventListener("blur", () => {
        const selected = (document.querySelector('input[name="delivery_days"]:checked') || {}).value;
        const val = parseInt(qtyInput.value || "0", 10);
        if (selected === "6_11" && val < 5) {
            alert("For 6–11 day delivery, the minimum quantity is 5 pieces.");
            qtyInput.value = 5;
        }
    });

    // React to delivery_days changes
    document.querySelectorAll('input[name="delivery_days"]').forEach(radio => {
        radio.addEventListener("change", () => {
            enforceQuantityRule();
            calculatePrice();
        });
    });
    // Initial enforce on load
    enforceQuantityRule();

    // --- PRICE CALCULATION (unchanged) ---
    function calculatePrice() {
        const formData = new FormData(form);
        fetch(window.location.href, { method: "POST", body: formData })
        .then(res => res.json())
        .then(data => {
            if (data.error) {
                document.getElementById("price-6-11").innerText = "Error";
                document.getElementById("price-urgent").innerText = "Error";
                document.getElementById("price-display").innerText = "Error";
                return;
            }
            document.getElementById("price-6-11").innerText = "Rs." + parseFloat(data.price_6_11).toFixed(2);
            document.getElementById("price-urgent").innerText = "Rs." + parseFloat(data.price_urgent).toFixed(2);

            const selected = document.querySelector('input[name="delivery_days"]:checked').value;
            document.getElementById("price-display").innerText =
                selected === "6_11" ? "Rs." + parseFloat(data.price_6_11).toFixed(2)
                                    : "Rs." + parseFloat(data.price_urgent).toFixed(2);

            window.latestPcbQuote = data;
        })
        .catch(err => console.error("Price fetch error", err));
    }
    document.addEventListener("change", function(e) {
        if (e.target.closest("#quote-form") || e.target.name === "delivery_days") {
            calculatePrice();
        }
    });
    calculatePrice();

    // --- ORDER BUTTON HANDLER ---
    orderBtn.addEventListener("click", async function (event) {
        event.preventDefault();

        if (!validateForm()) return;

        orderBtn.disabled = true;
        orderBtn.textContent = "Processing...";

        const gerberFile = gerberFileInput.files[0];
        if (!gerberFile || !gerberFile.name.toLowerCase().endsWith(".zip") || gerberFile.size > 10 * 1024 * 1024) {
            alert("Upload a valid .zip Gerber file under 10MB.");
            orderBtn.disabled = false;
            orderBtn.textContent = "Order Now";
            return;
        }

        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF("p", "mm", "a4");

            // Header logo (slightly taller for visibility)
            try {
                const headerImg = await fetch("https://itelectrotech.com/wp-content/uploads/2025/03/header.png")
                    .then(res => res.blob())
                    .then(b => createImageBitmap(b));
                const canvas = document.createElement("canvas");
                canvas.width = headerImg.width;
                canvas.height = headerImg.height;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(headerImg, 0, 0);
                const dataUrl = canvas.toDataURL("image/png");
                doc.addImage(dataUrl, "PNG", 10, 5, 190, 35); // height increased
            } catch {}

            // Title
            doc.setFontSize(16);
            doc.setTextColor(40, 40, 40);
            doc.text("PCB Quote Summary", 105, 50, { align: "center" });

            // Customer Info
            const name = document.getElementById("customer-name").value.trim();
            const phone = document.getElementById("customer-phone").value.trim();
            const email = document.getElementById("customer-email").value.trim();

            doc.setFontSize(12);
            doc.setTextColor(60, 60, 60);
            doc.text(`Customer Name: ${name}`, 14, 65);
            doc.text(`Customer Phone: ${phone}`, 14, 72);
            doc.text(`Customer Email: ${email}`, 14, 79);

            // Order Details Table
            const formData = new FormData(form);
            const orderDetails = [];
            for (let [key, value] of formData.entries()) {
                if (key === "gerber-file" || key === "customer_name" || key === "customer_phone" || key === "customer-email") continue;
                orderDetails.push([key.replace(/_/g, " ").toUpperCase(), value]);
            }

            const deliveryInput =
                document.querySelector(".price-days-container input:checked") ||
                document.querySelector('input[name="delivery_days"]:checked');

            if (deliveryInput) {
                orderDetails.push(["DELIVERY TIME", deliveryInput.value]);
            }
            orderDetails.push(["TOTAL PRICE", priceDisplay.innerText]);
            orderDetails.push(["GERBER FILE", gerberFile.name]);

            doc.autoTable({
                startY:  ninetyStartY(), // keep table clear of header block
                head: [["Field", "Value"]],
                body: orderDetails,
                styles: { fontSize: 11, cellPadding: 4 },
                headStyles: { fillColor: [41, 22, 111], textColor: 255, halign: "center" },
                bodyStyles: { textColor: [50, 50, 50] },
                alternateRowStyles: { fillColor: [245, 245, 245] },
                theme: "striped"
            });

            // Footer
            try {
                const footerImg = await fetch("https://itelectrotech.com/wp-content/uploads/2025/03/footer.png")
                    .then(res => res.blob())
                    .then(b => createImageBitmap(b));
                const canvas = document.createElement("canvas");
                canvas.width = footerImg.width;
                canvas.height = footerImg.height;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(footerImg, 0, 0);
                const dataUrl = canvas.toDataURL("image/png");
                const pageHeight = doc.internal.pageSize.height;
                doc.addImage(dataUrl, "PNG", 10, pageHeight - 35, 190, 25); // footer fixed nicely
            } catch {}

            pdfBlob = doc.output("blob");

            // --- ZIP + Email Sending ---
            const zip = new JSZip();
            zip.file("pcb-quote-summary.pdf", pdfBlob);
            zip.file(gerberFile.name, await gerberFile.arrayBuffer());
            zipBlob = await zip.generateAsync({ type: "blob" });

            const emailFormData = new FormData();
            emailFormData.append("action", "send_pcb_order_email");
            emailFormData.append("nonce", pcbOrderData.nonce);

            if (!email) {
                throw new Error("Customer email is required.");
            }

            emailFormData.append("userEmail", email);
            emailFormData.append("manufacturerEmail", "hafiz.musab.mahmood@itelectrotech.com");
            emailFormData.append("zipFile", new File([zipBlob], `pcb-order-${Date.now()}.zip`, { type: "application/zip" }));

            const res = await fetch(pcbOrderData.ajaxurl, { method: "POST", body: emailFormData });
            const result = await res.json();
            if (!res.ok || !result.success) throw new Error(result?.data?.message || "Email failed");

            tickPopup.style.display = "block";
            setTimeout(() => tickPopup.style.display = "none", 2000);
            summarySection.style.display = "block";
            alert("Order submitted! PDF emailed.");

        } catch (err) {
            alert("Order failed: " + err.message);
        } finally {
            orderBtn.disabled = false;
            orderBtn.textContent = "Order Now";
        }
    });

    // Helper so we don't hardcode startY
    function ninetyStartY() {
        // Header image + title + 3 lines customer info ≈ 90mm
        return 90;
    }

    if (downloadPdfButton) {
        downloadPdfButton.addEventListener("click", function () {
            if (!zipBlob) return alert("Submit order first to generate PDF/ZIP.");
            const link = document.createElement("a");
            link.href = URL.createObjectURL(zipBlob);
            link.download = "pcb-order-files.zip";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    }
