    // Elements
    const holeTypeRadios = document.querySelectorAll("input[name='hole_type']");
    const layerRadios = document.querySelectorAll("input[name='layers']");
    const fr4Radios = document.querySelectorAll("input[name='fr4_thickness']");
    const copperGroup = document.getElementById("copper-thickness-group");
    const urgentRadio = document.querySelector("input[name='delivery_days'][value='urgent']");
    const urgentLabel = document.querySelector("label.urgent-label");

    // Copper option sets
    const copperSets = {
        "1mm_2layer": [
            { value: "18um", label: "18µm (0.5oz)" },
            { value: "35um", label: "35µm (1oz)" },
            { value: "70um", label: "70µm (2oz)" },
            { value: "105um", label: "105µm (3oz)" }
        ],
        "default": [
            { value: "35um", label: "35µm (1oz)" },
            { value: "70um", label: "70µm (2oz)" },
            { value: "105um", label: "105µm (3oz)" }
        ]
    };

    // --- update copper thickness radio buttons dynamically ---
    function updateCopperOptions() {
        // safe-guard
        if (!copperGroup) return;

        const fr4 = document.querySelector("input[name='fr4_thickness']:checked")?.value;
        const layers = document.querySelector("input[name='layers']:checked")?.value;

        const options = (fr4 === "1mm" && layers === "2") ? copperSets["1mm_2layer"] : copperSets["default"];

        copperGroup.innerHTML = ""; // clear
        options.forEach((opt, i) => {
            const label = document.createElement("label");
            label.className = "copper-label";
            const input = document.createElement("input");
            input.type = "radio";
            input.name = "copper_thickness";
            input.value = opt.value;
            if (i === 0) input.checked = true;
            label.appendChild(input);
            label.append(" " + opt.label);
            copperGroup.appendChild(label);
        });
    }

    // --- enable/disable hole-type when layer = 1; add visual class ---
    function updateHoleTypeAvailability() {
        const layers = document.querySelector("input[name='layers']:checked")?.value;
        const holeTypeLabels = document.querySelectorAll("label.hole-type-label");

        if (layers === "1") {
            holeTypeRadios.forEach(radio => radio.disabled = true);
            holeTypeLabels.forEach(lbl => lbl.classList.add("hole-disabled"));
            // ensure NPTH selected
            const npth = document.querySelector("input[name='hole_type'][value='npth']");
            if (npth) npth.checked = true;
        } else {
            holeTypeRadios.forEach(radio => radio.disabled = false);
            holeTypeLabels.forEach(lbl => lbl.classList.remove("hole-disabled"));
        }
    }

    // --- disable/enable urgent when PTH is selected, plus visual class ---
    function updateUrgentAvailability() {
        if (!urgentRadio) return;
        const hole = document.querySelector("input[name='hole_type']:checked")?.value;

        if (hole === "pth") {
            urgentRadio.disabled = true;
            if (urgentLabel) urgentLabel.classList.add("urgent-disabled");
            // If urgent was selected, fallback to 6_11
            const fallback = document.querySelector("input[name='delivery_days'][value='6_11']");
            if (urgentRadio.checked && fallback) fallback.checked = true;
        } else {
            urgentRadio.disabled = false;
            if (urgentLabel) urgentLabel.classList.remove("urgent-disabled");
        }
    }

    // Attach listeners
    layerRadios.forEach(r => r.addEventListener("change", () => {
        updateHoleTypeAvailability();
        updateCopperOptions();
        updateUrgentAvailability();
    }));
    fr4Radios.forEach(r => r.addEventListener("change", () => {
        updateCopperOptions();
        // if fr4 change leads to copper set change, nothing else required
    }));
    holeTypeRadios.forEach(r => r.addEventListener("change", updateUrgentAvailability));

    // Initialize on load
    updateCopperOptions();
    updateHoleTypeAvailability();
    updateUrgentAvailability();
